# ============================================================
# InstaTern — Production Configuration
# ============================================================

PORT=8080
ENV=production
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DB_PATH=instagram.db
ALLOWED_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000

# ============================================================
# Ternline Cloud SDK Configuration (https://ternline.vercel.app/docs)
# ============================================================
TERNLINE_ENDPOINT=https://ternline.vercel.app
TERNLINE_API_KEY=your_provisioned_api_key_here
TERNLINE_APP_ID=instagram-app
TERNLINE_SERVICE_ID=instagram-api
TELEMETRY_ENABLED=true
