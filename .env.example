# ============================================================
# InstaTern — Instagram Test Application Environment Variables
# ============================================================

# App Configuration
PORT=8080
ENV=development

# Cyber Engine Backend URL
# - When running locally: http://localhost:8000
# - When hosted in Cloud (e.g. Cloud Run): https://cyber-engine-<hash>-uc.a.run.app
CYBER_ENGINE_URL=http://localhost:8000

# Cyber Engine API Key & Identifiers
CYBER_ENGINE_API_KEY=ce_live_test_api_key_secret_12345
TENANT_ID=tenant-alpha
APP_ID=instagram-app
SERVICE_ID=instagram-api

# Telemetry Settings
TELEMETRY_ENABLED=true
TELEMETRY_BUFFERED=false

