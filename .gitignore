@"
# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution & Packaging
.Python
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets and local environments (never commit secrets)
.env
.env.local
.env.*.local
!.env.example

# Local databases and Docker volumes
postgres_data/
*.sqlite3
*.db

# Testing and Coverage
.pytest_cache/
.coverage
htmlcov/

# Editor and IDE configurations
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
"@ | Set-Content -Encoding UTF8 .gitignore